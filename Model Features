def create_gr_rolling_features(df, well_col='WELL_ID', md_col='MD', gr_col='GR_imputed', windows=[5, 10, 25, 50]):
    """
    Create rolling window statistics for GR
    """
    df = df.copy()
    df = df.sort_values([well_col, md_col]).reset_index(drop=True)

    for window in windows:
        df[f'GR_mean_{window}'] = np.nan
        df[f'GR_std_{window}'] = np.nan
        df[f'GR_min_{window}'] = np.nan
        df[f'GR_max_{window}'] = np.nan
        df[f'GR_range_{window}'] = np.nan

    df['GR_gradient'] = np.nan
    df['GR_zscore'] = np.nan

    for well_id in df[well_col].unique():
        well_mask = df[well_col] == well_id
        gr_values = df.loc[well_mask, gr_col].values

        for window in windows:
            if len(gr_values) >= window:
                # Rolling mean
                rolling_mean = pd.Series(gr_values).rolling(window, center=True, min_periods=1).mean().values
                df.loc[well_mask, f'GR_mean_{window}'] = rolling_mean

                # Rolling std
                rolling_std = pd.Series(gr_values).rolling(window, center=True, min_periods=1).std().values
                df.loc[well_mask, f'GR_std_{window}'] = rolling_std

                # Rolling min/max
                rolling_min = pd.Series(gr_values).rolling(window, center=True, min_periods=1).min().values
                rolling_max = pd.Series(gr_values).rolling(window, center=True, min_periods=1).max().values
                df.loc[well_mask, f'GR_min_{window}'] = rolling_min
                df.loc[well_mask, f'GR_max_{window}'] = rolling_max
                df.loc[well_mask, f'GR_range_{window}'] = rolling_max - rolling_min

        # GR gradient (rate of change)
        df.loc[well_mask, 'GR_gradient'] = np.gradient(gr_values)

        # GR z-score (normalized)
        gr_mean = np.nanmean(gr_values)
        gr_std = np.nanstd(gr_values)
        if gr_std > 0:
            df.loc[well_mask, 'GR_zscore'] = (gr_values - gr_mean) / gr_std

    return df

