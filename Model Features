def create_spatial_features(df, well_col='WELL_ID', md_col='MD', x_col='X', y_col='Y', z_col='Z'):
    """
    Create features based on well trajectory
    """
    df = df.copy()
    df = df.sort_values([well_col, md_col]).reset_index(drop=True)

    # Initialize columns
    df['dX'] = np.nan
    df['dY'] = np.nan
    df['dZ'] = np.nan
    df['dMD'] = np.nan
    df['horizontal_displacement'] = np.nan
    df['total_displacement'] = np.nan
    df['inclination'] = np.nan
    df['azimuth'] = np.nan
    df['curvature'] = np.nan

    for well_id in df[well_col].unique():
        well_mask = df[well_col] == well_id
        idx = df.index[well_mask]

        x = df.loc[well_mask, x_col].values
        y = df.loc[well_mask, y_col].values
        z = df.loc[well_mask, z_col].values
        md = df.loc[well_mask, md_col].values

        # Calculate differences
        dx = np.diff(x, prepend=x[0])
        dy = np.diff(y, prepend=y[0])
        dz = np.diff(z, prepend=z[0])
        dmd = np.diff(md, prepend=md[0])

        df.loc[idx, 'dX'] = dx
        df.loc[idx, 'dY'] = dy
        df.loc[idx, 'dZ'] = dz
        df.loc[idx, 'dMD'] = dmd

        # Horizontal displacement per step
        horiz_disp = np.sqrt(dx**2 + dy**2)
        df.loc[idx, 'horizontal_displacement'] = horiz_disp

        # Total displacement per step
        total_disp = np.sqrt(dx**2 + dy**2 + dz**2)
        df.loc[idx, 'total_displacement'] = total_disp

        # Inclination (angle from vertical)
        with np.errstate(divide='ignore', invalid='ignore'):
            inclination = np.degrees(np.arctan2(horiz_disp, np.abs(dz)))
            inclination = np.where(np.isnan(inclination), 90, inclination)
        df.loc[idx, 'inclination'] = inclination

        # Azimuth (direction in XY plane)
        azimuth = np.degrees(np.arctan2(dx, dy)) % 360
        df.loc[idx, 'azimuth'] = azimuth

        # Curvature (rate of direction change)
        if len(azimuth) > 2:
            curvature = np.abs(np.diff(azimuth, prepend=azimuth[0]))
            curvature = np.minimum(curvature, 360 - curvature)  # Handle wrap-around
            df.loc[idx, 'curvature'] = curvature

    return df

