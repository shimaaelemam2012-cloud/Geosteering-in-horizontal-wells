def impute_gr(df, well_col='WELL_ID', gr_col='GR', md_col='MD', method='linear'):
    """
    Impute missing GR values using interpolation

    Parameters:
    - df: DataFrame with GR data
    - method: 'linear', 'nearest', or 'rolling'

    Returns:
    - DataFrame with imputed GR
    """
    df = df.copy()
    df = df.sort_values([well_col, md_col]).reset_index(drop=True)

    imputed_count = 0
    total_missing = df[gr_col].isna().sum()

    for well_id in df[well_col].unique():
        mask = df[well_col] == well_id
        well_data = df.loc[mask, [md_col, gr_col]].copy()

        if well_data[gr_col].isna().any() and well_data[gr_col].notna().sum() >= 2:
            # Get valid points for interpolation
            valid_mask = well_data[gr_col].notna()

            if valid_mask.sum() >= 2:
                if method == 'linear':
                    # Linear interpolation
                    interp_func = interp1d(
                        well_data.loc[valid_mask, md_col],
                        well_data.loc[valid_mask, gr_col],
                        kind='linear',
                        bounds_error=False,
                        fill_value='extrapolate'
                    )
                    imputed_values = interp_func(well_data[md_col])

                elif method == 'nearest':
                    interp_func = interp1d(
                        well_data.loc[valid_mask, md_col],
                        well_data.loc[valid_mask, gr_col],
                        kind='nearest',
                        bounds_error=False,
                        fill_value='extrapolate'
                    )
                    imputed_values = interp_func(well_data[md_col])

                else:  # rolling
                    imputed_values = well_data[gr_col].fillna(method='ffill').fillna(method='bfill')

                # Update only missing values
                missing_idx = df.index[mask & df[gr_col].isna()]
                df.loc[missing_idx, gr_col] = imputed_values[well_data[gr_col].isna()]
                imputed_count += len(missing_idx)

    print(f"  Total missing before: {total_missing:,}")
    print(f"  Imputed: {imputed_count:,}")
    print(f"  Remaining missing: {df[gr_col].isna().sum():,}")

    return df

