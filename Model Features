def extract_anchor_features(df, well_col='WELL_ID', md_col='MD', tvt_col='TVT_input', z_col='Z'):
    """
    Extract anchor point features from the heel section where TVT_input exists
    """
    df = df.copy()
    df = df.sort_values([well_col, md_col]).reset_index(drop=True)

    anchor_info = {}

    for well_id in df[well_col].unique():
        well_mask = df[well_col] == well_id
        well_data = df.loc[well_mask].copy()

        # Find anchor section (where TVT_input exists)
        anchor_mask = well_data[tvt_col].notna()

        if anchor_mask.any():
            anchor_data = well_data[anchor_mask]

            # Extract anchor statistics
            anchor_info[well_id] = {
                # Anchor boundaries
                'anchor_md_min': anchor_data[md_col].min(),
                'anchor_md_max': anchor_data[md_col].max(),
                'anchor_z_min': anchor_data[z_col].min(),
                'anchor_z_max': anchor_data[z_col].max(),
                'anchor_tvt_min': anchor_data[tvt_col].min(),
                'anchor_tvt_max': anchor_data[tvt_col].max(),

                # Last anchor point (transition point to lateral)
                'last_anchor_md': anchor_data[md_col].max(),
                'last_anchor_z': anchor_data.loc[anchor_data[md_col].idxmax(), z_col],
                'last_anchor_tvt': anchor_data.loc[anchor_data[md_col].idxmax(), tvt_col],

                # Offset at last anchor point
                'last_anchor_offset': (anchor_data.loc[anchor_data[md_col].idxmax(), tvt_col] +
                                       anchor_data.loc[anchor_data[md_col].idxmax(), z_col]),

                # TVT gradient in anchor section
                'anchor_tvt_range': anchor_data[tvt_col].max() - anchor_data[tvt_col].min(),
                'anchor_z_range': anchor_data[z_col].max() - anchor_data[z_col].min(),
                'anchor_md_range': anchor_data[md_col].max() - anchor_data[md_col].min(),

                # Count
                'anchor_count': anchor_mask.sum(),
                'total_count': len(well_data),
                'anchor_coverage': anchor_mask.sum() / len(well_data)
            }

            # Calculate TVT/Z gradient if there's enough range
            if abs(anchor_info[well_id]['anchor_z_range']) > 1:
                anchor_info[well_id]['tvt_z_gradient'] = (
                    anchor_info[well_id]['anchor_tvt_range'] /
                    abs(anchor_info[well_id]['anchor_z_range'])
                )
            else:
                anchor_info[well_id]['tvt_z_gradient'] = 1.0

    return anchor_info

