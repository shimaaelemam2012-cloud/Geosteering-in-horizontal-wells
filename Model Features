def compute_gr_match_features(horizontal_df, typewell_signatures, anchor_info,
                               well_col='WELL_ID', md_col='MD', gr_col='GR_imputed'):
    """
    Compute features that measure how well horizontal GR matches typewell GR
    at different TVT levels
    """
    df = horizontal_df.copy()

    # Initialize matching features
    df['typewell_gr_at_extrapolated_tvt'] = np.nan
    df['gr_residual'] = np.nan
    df['gr_match_score'] = np.nan

    for well_id in df[well_col].unique():
        if well_id not in typewell_signatures or well_id not in anchor_info:
            continue

        well_mask = df[well_col] == well_id
        sig = typewell_signatures[well_id]

        # Get extrapolated TVT values
        tvt_extrap = df.loc[well_mask, 'TVT_extrapolated_offset'].values

        # Get horizontal GR values
        horiz_gr = df.loc[well_mask, gr_col].values

        # Get typewell GR at extrapolated TVT positions
        typewell_gr = sig['interp_func'](tvt_extrap)
        df.loc[well_mask, 'typewell_gr_at_extrapolated_tvt'] = typewell_gr

        # Compute residual (horizontal GR - typewell GR)
        residual = horiz_gr - typewell_gr
        df.loc[well_mask, 'gr_residual'] = residual

        # Compute match score (normalized by typewell std)
        if sig['gr_std'] > 0:
            match_score = 1 - np.abs(residual) / (2 * sig['gr_std'])
            match_score = np.clip(match_score, 0, 1)
            df.loc[well_mask, 'gr_match_score'] = match_score

    return df

