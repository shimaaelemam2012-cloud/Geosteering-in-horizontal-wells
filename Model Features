def create_typewell_signatures(typewell_df, well_col='WELL_ID', tvt_col='TVT', gr_col='GR'):
    """
    Create GR signature lookup for each typewell
    """
    signatures = {}

    for well_id in typewell_df[well_col].unique():
        well_data = typewell_df[typewell_df[well_col] == well_id].copy()
        well_data = well_data.sort_values(tvt_col).reset_index(drop=True)

        # Remove missing GR
        valid_data = well_data[well_data[gr_col].notna()]

        if len(valid_data) > 10:
            signatures[well_id] = {
                'tvt': valid_data[tvt_col].values,
                'gr': valid_data[gr_col].values,
                'tvt_min': valid_data[tvt_col].min(),
                'tvt_max': valid_data[tvt_col].max(),
                'gr_mean': valid_data[gr_col].mean(),
                'gr_std': valid_data[gr_col].std(),
                'interp_func': interp1d(
                    valid_data[tvt_col].values,
                    valid_data[gr_col].values,
                    kind='linear',
                    bounds_error=False,
                    fill_value='extrapolate'
                )
            }

    return signatures

