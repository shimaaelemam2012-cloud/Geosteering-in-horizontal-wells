def create_z_extrapolation_features(df, anchor_info, well_col='WELL_ID', md_col='MD', z_col='Z'):
    """
    Create features for TVT extrapolation based on Z depth relationship
    """
    df = df.copy()

    # Initialize new columns
    df['Z_from_anchor'] = np.nan
    df['MD_from_anchor'] = np.nan
    df['TVT_extrapolated_offset'] = np.nan
    df['TVT_extrapolated_gradient'] = np.nan
    df['is_lateral'] = False
    df['distance_to_anchor'] = np.nan

    for well_id in df[well_col].unique():
        if well_id not in anchor_info:
            continue

        well_mask = df[well_col] == well_id
        anchor = anchor_info[well_id]

        # Mark lateral section (beyond anchor)
        df.loc[well_mask, 'is_lateral'] = df.loc[well_mask, md_col] > anchor['last_anchor_md']

        # Z difference from last anchor point
        df.loc[well_mask, 'Z_from_anchor'] = df.loc[well_mask, z_col] - anchor['last_anchor_z']

        # MD difference from last anchor point
        df.loc[well_mask, 'MD_from_anchor'] = df.loc[well_mask, md_col] - anchor['last_anchor_md']

        # Distance to anchor (always positive)
        df.loc[well_mask, 'distance_to_anchor'] = np.abs(df.loc[well_mask, md_col] - anchor['last_anchor_md'])

        # Method 1: Constant Offset Extrapolation
        # TVT = Offset - Z (where Offset = TVT + Z at anchor)
        df.loc[well_mask, 'TVT_extrapolated_offset'] = anchor['last_anchor_offset'] - df.loc[well_mask, z_col]

        # Method 2: Gradient-based Extrapolation
        # TVT = last_TVT + gradient * delta_Z
        z_delta = df.loc[well_mask, z_col] - anchor['last_anchor_z']
        df.loc[well_mask, 'TVT_extrapolated_gradient'] = (
            anchor['last_anchor_tvt'] + anchor['tvt_z_gradient'] * np.abs(z_delta)
        )

    return df

