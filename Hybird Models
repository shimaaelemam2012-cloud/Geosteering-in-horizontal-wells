def find_best_tvt_by_gr_correlation(hz_gr, tw_gr, tw_tvt, baseline_tvt, search_range=50):
    """
    Find best TVT by matching horizontal GR to typewell GR.
    Search within ±search_range of baseline_tvt.
    """
    if np.isnan(hz_gr) or len(tw_gr) < 10:
        return baseline_tvt, 0.0

    # Create interpolated typewell GR function
    valid_mask = ~np.isnan(tw_gr) & ~np.isnan(tw_tvt)
    if valid_mask.sum() < 10:
        return baseline_tvt, 0.0

    tw_gr_valid = tw_gr[valid_mask]
    tw_tvt_valid = tw_tvt[valid_mask]

    # Sort by TVT
    sort_idx = np.argsort(tw_tvt_valid)
    tw_tvt_sorted = tw_tvt_valid[sort_idx]
    tw_gr_sorted = tw_gr_valid[sort_idx]

    # Find TVT where typewell GR is closest to horizontal GR
    min_tvt = max(tw_tvt_sorted.min(), baseline_tvt - search_range)
    max_tvt = min(tw_tvt_sorted.max(), baseline_tvt + search_range)

    if min_tvt >= max_tvt:
        return baseline_tvt, 0.0

    # Search for best match
    tvt_candidates = np.linspace(min_tvt, max_tvt, 100)
    gr_interp = interp1d(tw_tvt_sorted, tw_gr_sorted, kind='linear',
                         bounds_error=False, fill_value='extrapolate')

    tw_gr_at_candidates = gr_interp(tvt_candidates)
    gr_diff = np.abs(tw_gr_at_candidates - hz_gr)

    best_idx = np.argmin(gr_diff)
    best_tvt = tvt_candidates[best_idx]
    match_score = 1.0 / (1.0 + gr_diff[best_idx])

    return best_tvt, match_score

def refine_tvt_with_gr_sequence(hz_data, tw_data, baseline_tvt, window=10):
    """
    Refine TVT predictions using GR sequence correlation.
    """
    hz_gr = hz_data['GR'].values if 'GR' in hz_data.columns else hz_data['GR_imputed'].values
    hz_md = hz_data['MD'].values

    tw_gr = tw_data['GR'].values
    tw_tvt = tw_data['TVT'].values

    refined_tvt = baseline_tvt.copy()
    match_scores = np.zeros(len(baseline_tvt))

    for i in range(len(hz_data)):
        # Get local GR window
        start_idx = max(0, i - window//2)
        end_idx = min(len(hz_data), i + window//2)

        local_hz_gr = hz_gr[start_idx:end_idx]
        local_baseline = baseline_tvt[start_idx:end_idx]

        if len(local_hz_gr) < 3 or np.all(np.isnan(local_hz_gr)):
            continue

        # Find best TVT for center point
        center_gr = hz_gr[i]
        center_baseline = baseline_tvt[i]

        best_tvt, score = find_best_tvt_by_gr_correlation(
            center_gr, tw_gr, tw_tvt, center_baseline, search_range=30
        )

        refined_tvt[i] = best_tvt
        match_scores[i] = score

    return refined_tvt, match_scores

