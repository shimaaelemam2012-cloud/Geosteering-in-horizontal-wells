def engineer_features(df, typewell_df, is_train=True):
    """Create features for the model including DTW alignment"""
    df = df.copy()

    # Basic features
    df['offset'] = df['TVT'] + df['Z'] if 'TVT' in df.columns else np.nan
    global_mean_offset = 2112.8

    df['Z_abs'] = df['Z'].abs()
    df['estimated_TVT_from_Z'] = -df['Z'] + global_mean_offset
    df['GR_filled'] = df['GR'].fillna(df['GR'].median() if df['GR'].notna().any() else 75)

    well_features = []
    unique_wells = df['WELL_ID'].unique()
    total_wells = len(unique_wells)

    for i, well_id in enumerate(unique_wells):
        if i % 50 == 0:
            print(f"   -> Processing Well {i}/{total_wells}...")

        well_mask = df['WELL_ID'] == well_id
        well_data = df[well_mask].copy().sort_values('MD')

        # Spatial features
        well_data['MD_min'] = well_data['MD'].min()
        well_data['MD_max'] = well_data['MD'].max()
        well_data['MD_range'] = well_data['MD_max'] - well_data['MD_min']
        well_data['MD_normalized'] = (well_data['MD'] - well_data['MD_min']) / (well_data['MD_range'] + 1e-6)

        well_data['Z_min'] = well_data['Z'].min()
        well_data['Z_max'] = well_data['Z'].max()
        well_data['Z_range'] = well_data['Z_max'] - well_data['Z_min']

        # Rolling GR stats
        well_data['GR_roll_mean_5'] = well_data['GR_filled'].rolling(5, min_periods=1, center=True).mean()
        well_data['GR_roll_std_5'] = well_data['GR_filled'].rolling(5, min_periods=1, center=True).std().fillna(0)
        well_data['GR_roll_mean_10'] = well_data['GR_filled'].rolling(10, min_periods=1, center=True).mean()
        well_data['GR_roll_std_10'] = well_data['GR_filled'].rolling(10, min_periods=1, center=True).std().fillna(0)
        well_data['GR_roll_mean_20'] = well_data['GR_filled'].rolling(20, min_periods=1, center=True).mean()

        # Derivatives
        well_data['GR_diff'] = well_data['GR_filled'].diff().fillna(0)
        well_data['GR_diff2'] = well_data['GR_diff'].diff().fillna(0)
        well_data['Z_diff'] = well_data['Z'].diff().fillna(0)
        well_data['MD_diff'] = well_data['MD'].diff().fillna(well_data['MD'].diff().median())
        well_data['Z_gradient'] = well_data['Z_diff'] / (well_data['MD_diff'] + 1e-6)
        well_data['inclination_proxy'] = np.arctan(well_data['Z_gradient'].clip(-1, 1)) * 180 / np.pi
        well_data['cumsum_Z_diff'] = well_data['Z_diff'].cumsum()

        # Extrapolations and anchor points
        if is_train:
            well_data['TVT_lag1'] = well_data['TVT'].shift(1)
            well_data['TVT_lag5'] = well_data['TVT'].shift(5)
            well_data['TVT_diff'] = well_data['TVT'].diff().fillna(0)
            tvt_for_match = well_data['TVT']
        else:
            tvt_col = 'TVT_input' if 'TVT_input' in well_data.columns else 'TVT'
            known_tvt_mask = well_data[tvt_col].notna()
            if known_tvt_mask.any():
                last_known_idx = well_data[known_tvt_mask].index[-1]
                last_known_tvt = well_data.loc[last_known_idx, tvt_col]
                last_known_z = well_data.loc[last_known_idx, 'Z']
                last_known_md = well_data.loc[last_known_idx, 'MD']

                well_data['last_known_TVT'] = last_known_tvt
                well_data['last_known_Z'] = last_known_z
                well_data['last_known_MD'] = last_known_md
                well_data['dist_from_last_known'] = well_data['MD'] - last_known_md
                well_data['Z_change_from_known'] = well_data['Z'] - last_known_z
                last_offset = last_known_tvt + last_known_z
                well_data['TVT_extrapolated'] = -well_data['Z'] + last_offset
            else:
                well_data['last_known_TVT'] = np.nan
                well_data['last_known_Z'] = np.nan
                well_data['last_known_MD'] = np.nan
                well_data['dist_from_last_known'] = np.nan
                well_data['Z_change_from_known'] = np.nan
                well_data['TVT_extrapolated'] = -well_data['Z'] + global_mean_offset

            tvt_for_match = well_data['TVT_extrapolated']

        tvt_for_match = tvt_for_match.fillna(well_data['estimated_TVT_from_Z'])

        # =========================================================
        # 🔥 THE DTW INJECTION 🔥
        # =========================================================
        tw_data = typewell_df[typewell_df['WELL_ID'] == well_id].sort_values('TVT').dropna(subset=['TVT', 'GR'])

        if len(tw_data) > 1 and len(well_data) > 1:
            lat_gr = well_data['GR_filled'].values
            tw_gr = tw_data['GR'].values
            tw_tvt = tw_data['TVT'].values

            # 1. Run Dynamic Time Warping (Radius 50 prevents impossible geological leaps)
            distance, path = fastdtw(lat_gr, tw_gr, radius=50, dist=lambda a, b: abs(a - b))

            # 2. Map the Typewell TVT to the Lateral MD based on the DTW path
            dtw_tvt_aligned = np.zeros(len(lat_gr))
            counts = np.zeros(len(lat_gr))
            for lat_idx, tw_idx in path:
                dtw_tvt_aligned[lat_idx] += tw_tvt[tw_idx]
                counts[lat_idx] += 1

            # Average multi-matches and fill the feature
            well_data['DTW_TVT_match'] = dtw_tvt_aligned / counts

            # 3. Old Interpolation as a backup/secondary feature
            from scipy.interpolate import interp1d
            interp = interp1d(tw_data['TVT'], tw_data['GR'], kind='nearest', bounds_error=False, fill_value='extrapolate')
            well_data['typewell_GR_match'] = interp(tvt_for_match)

        else:
            well_data['DTW_TVT_match'] = tvt_for_match # Fallback to extrapolation if typewell missing
            well_data['typewell_GR_match'] = np.nan

        well_data['typewell_TVT_match'] = tvt_for_match
        well_data['GR_typewell_diff'] = well_data['GR_filled'] - well_data['typewell_GR_match']
        well_data['DTW_residual_proxy'] = well_data['DTW_TVT_match'] - well_data['typewell_TVT_match']

        well_features.append(well_data)

    return pd.concat(well_features, ignore_index=True)

