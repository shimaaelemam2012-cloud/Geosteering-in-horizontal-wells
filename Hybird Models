def extract_anchor_features(hz_data, well_id):
    """Extract anchor features from horizontal data with TVT_input."""
    well_hz = hz_data[hz_data['WELL_ID'] == well_id].sort_values('MD').copy()

    # Find anchor points (where TVT_input is available)
    if 'TVT_input' in well_hz.columns:
        anchor_mask = well_hz['TVT_input'].notna()
    else:
        # Use first 25% as pseudo-anchors for training validation
        n_anchor = int(len(well_hz) * 0.25)
        anchor_mask = pd.Series([True]*n_anchor + [False]*(len(well_hz)-n_anchor), index=well_hz.index)

    if anchor_mask.sum() == 0:
        return None

    anchor_data = well_hz[anchor_mask]

    # Get last anchor point
    last_anchor_idx = anchor_data.index[-1]
    last_anchor = anchor_data.loc[last_anchor_idx]

    # Calculate offset at anchor
    if 'TVT_input' in well_hz.columns and pd.notna(last_anchor.get('TVT_input')):
        last_tvt = last_anchor['TVT_input']
    elif 'TVT' in well_hz.columns:
        last_tvt = last_anchor['TVT']
    else:
        return None

    last_z = last_anchor['Z']
    offset = last_tvt + last_z  # TVT = -Z + offset

    # Calculate gradient from anchor section
    if len(anchor_data) > 10:
        z_vals = anchor_data['Z'].values
        if 'TVT_input' in anchor_data.columns:
            tvt_vals = anchor_data['TVT_input'].fillna(anchor_data.get('TVT', np.nan)).values
        else:
            tvt_vals = anchor_data['TVT'].values

        valid = ~np.isnan(tvt_vals)
        if valid.sum() > 5:
            gradient = np.polyfit(z_vals[valid], tvt_vals[valid], 1)[0]
        else:
            gradient = -1.0
    else:
        gradient = -1.0

    return {
        'last_anchor_md': last_anchor['MD'],
        'last_anchor_z': last_z,
        'last_anchor_tvt': last_tvt,
        'offset': offset,
        'gradient': gradient
    }

def predict_tvt_offset_based(hz_data, anchor_info):
    """Predict TVT using offset extrapolation."""
    z_vals = hz_data['Z'].values
    offset = anchor_info['offset']
    gradient = anchor_info['gradient']
    last_z = anchor_info['last_anchor_z']
    last_tvt = anchor_info['last_anchor_tvt']

    # Method 1: Simple offset
    pred_offset = -z_vals + offset

    # Method 2: Gradient-based
    z_diff = z_vals - last_z
    pred_gradient = last_tvt + gradient * z_diff

    # Blend: use gradient near anchor, transition to offset far away
    distance = np.abs(z_vals - last_z)
    max_dist = distance.max() if distance.max() > 0 else 1
    blend_weight = np.clip(distance / max_dist, 0, 1)

    pred_blended = (1 - blend_weight) * pred_gradient + blend_weight * pred_offset

    return pred_offset, pred_gradient, pred_blended

