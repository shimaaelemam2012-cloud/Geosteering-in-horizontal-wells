# Main preprocessing function
# Processes one well and returns a DataFrame with all the features suggested from the literature review.

FORMATION_ORDER = ['ANCC','ASTNU','ASTNL','EGFDU','EGFDL','BUDA']

def preprocess_well(well_id, data_dir):
    """
    Process one well and extract all features.
    """
    hz = pd.read_csv(data_dir / f'{well_id}_horizontal_well.csv')
    tw = pd.read_csv(data_dir / f'{well_id}_typewell.csv')
    # Detect TVT input column — the one that goes NaN at Prediction Start
    #starts by finding the TVT columns then find the TVT columns that goes NAN after PS(start of the missing values  in TVT)
    #goes through column by column (just for automation purposes this is used)
    tvt_cols = [c for c in hz.columns if 'tvt' in c.lower()]
    tvt_col  = next((c for c in tvt_cols if hz[c].isnull().any()), tvt_cols[0] if tvt_cols else 'TVT')

    # ── Step 1: Fix missing GR ────────────────────────────────────────────
    # Linear interpolation fills gaps between known values.
    # ffill/bfill handle edges where interpolation cannot reach.
    hz['GR'] = hz['GR'].interpolate(method='linear').ffill().bfill()

    # ── Step 2: Normalise GR per well (z-score) ───────────────────────────
    # Subtract mean and divide by std.
    # used to put all wells on the same scale
    mu, sigma = hz['GR'].mean(), hz['GR'].std()
    hz['GR_norm'] = (hz['GR'] - mu) / sigma if sigma > 0 else 0.0#to avoid any surprises

    # ── Step 3: Find Prediction Start ─────────────────────────────────────
    # Last row where TVT is known. Beyond this we must predict.
    ps = hz[tvt_col].last_valid_index()
    if ps is None: ps = len(hz) - 1#just to avoid potential crash if all TVT are missing not really vital this just wante to cover all grounds

    # ── Step 4: GR derivatives ────────────────────────────────────────────
    # GR_d1: first derivative — is GR rising or falling?
    #   Positive = entering shale. Negative = leaving shale.
    # GR_d2: second derivative — is the rate of change accelerating?
    #   High = approaching a geological boundary.
    hz['GR_d1'] = hz['GR_norm'].diff().fillna(0)
    hz['GR_d2'] = hz['GR_d1'].diff().fillna(0)

    # ── Step 5: GR volatility ─────────────────────────────────────────────
    # High volatility = may suggest thin beds or transition zone.
    # Low volatility = suggests stable layer interior.
    shifted = hz['GR'].shift(1).replace(0, np.nan)
    #divides current by previous GR reading and then log the result then calcuales the absolute value we only need change by how much
    hz['GR_vol']       = np.abs(np.log(hz['GR'].replace(0,np.nan)/shifted)).fillna(0)
    #computes the standard deviation of GR_VOL within each 25 row window (if fewer rows exist then use what is available)

    hz['GR_vol_std25'] = hz['GR_vol'].rolling(25,min_periods=1,center=True).std().fillna(0)

    # ── Step 6: Rolling windows at 4 spatial scales ───────────────────────
    # Captures geological character at different length scales.
    # 10 rows = may be local bed character
    # 100 rows = may be regional formation character
    for w in [10, 25, 50, 100]:
        hz[f'GR_mean_{w}'] = hz['GR_norm'].rolling(w,min_periods=1,center=True).mean()
        hz[f'GR_std_{w}']  = hz['GR_norm'].rolling(w,min_periods=1,center=True).std().fillna(0)

    # ── Step 7: DWT features ──────────────────────────────────────────────
    # Discrete Wavelet Transform decomposes GR into frequency layers.
    # Approximation = slow geological trend
    # Detail levels = progressively finer variations
    #idea retrieved from competition site
    #use cell  3 function and adds 4 DWT columns or features
    dwt_features = extract_dwt_features(hz['GR_norm'].values)
    for name, values in dwt_features.items():
        hz[name] = values

    # ── Step 8: Dip from trajectory ───────────────────────────────────────
    # dZ/dMD: rate of change of vertical depth per unit measured depth.
    # Positive = drill going deeper (TVT increases).
    # Negative = drill going upward (TVT decreases).
    if 'Z' in hz.columns and 'MD' in hz.columns:
        hz['dZ_dMD'] = (hz['Z'].diff() / hz['MD'].diff().replace(0,np.nan)).fillna(0)
    else:
        hz['dZ_dMD'] = 0.0

    # ── Step 9: Formation distances and absolute depths ───────────────────
    # dist_TOP = distance from current Z to formation top depth.
    # Zero = drill is exactly at that boundary.
    # Also store absolute formation top depths as direct features.
    top_depths = {}
    for top in FORMATION_ORDER:
        if top in hz.columns and 'Z' in hz.columns:#only proceeds if those formation columns exists in data in case something was deleted or other wells have something missing
            top_depth = hz[top].ffill().bfill()#handling missing data by using available forward or backward data (nearest and will be siilar data changes slowly)
            hz[f'dist_{top}'] = hz['Z'] - top_depth
            hz[f'abs_{top}']  = top_depth# same formation column but with missing values handled
            top_depths[top]   = top_depth
        else:
            hz[f'dist_{top}'] = 0.0
            hz[f'abs_{top}']  = 0.0
            top_depths[top]   = pd.Series(np.nan, index=hz.index)

    # ── Step 10:  formation_zone ──────────────────────────────────────
    # Which two formation topsbracket the current Z?
    # zone code = index where drill bit exists i.e
    #   0 = above ANCC
    #   1 = between ANCC and ASTNU
    #   2 = between ASTNU and ASTNL
    #   ...
    #   6 = below BUDA
    # This gives the model a direct "which layer am I in" signal instead
    # of inferring it from 6 separate dist_TOP columns.
    top_depth_matrix = pd.DataFrame(top_depths)
    z_col = hz['Z'] if 'Z' in hz.columns else pd.Series(0.0, index=hz.index)
    zone = np.zeros(len(hz), dtype=int)
    valid_tops = [t for t in FORMATION_ORDER if top_depth_matrix[t].notna().all()]
    if valid_tops:
        for t in valid_tops:
            zone += (z_col.values >= top_depth_matrix[t].values).astype(int)
    hz['formation_zone'] = zone

    # ── Step 11: Calibration window ───────────────────────────────────────
    # Mean and std of GR in last 500 rows before PS.
    #stored as a constant for all rows (last rows most releveant according to literature)
    # Captures what geological character the drill was just inside.
    cal = hz.loc[max(0,ps-500):ps, 'GR_norm']
    hz['calib_mean'] = cal.mean() if len(cal) > 0 else 0.0
    hz['calib_std']  = float(cal.std()) if len(cal) > 1 else 0.0

    # ── Step 12: Anchor features ──────────────────────────────────────────
        # TVT_last: last known TVT, forward filled. The geological anchor.still vary valuable desspite uncertainity as seen with feature importance in some models
    # dist_from_PS: feet beyond PS. Uncertainty grows with distance.
    hz['TVT_last']     = hz[tvt_col].ffill().bfill()
    hz['dist_from_PS'] = np.maximum(np.array(hz.index) - ps, 0)

    # ── Step 13:  DTW_pred ( DTW alignment) ──────────────────
    try:
        tw_s = tw.sort_values('TVT').dropna(subset=['TVT','GR']).reset_index(drop=True)
        if len(tw_s) > 1:
            hz_gr_matched = histogram_match(hz['GR'].values, tw_s['GR'].values)
            hz['DTW_pred'] = dtw_predict_tvt(hz_gr_matched, tw_s, bandwidth_pct=0.15)#calls function
        else:
            hz['DTW_pred'] = hz['TVT_last']
    except Exception:
        hz['DTW_pred'] = hz['TVT_last']

    # ── Step 14: Geographic coordinates ────────────────────────────────────
    # Well location. Wells close together share geological patterns.
    #each well should have very similar coordinates almost identical for all rows which represent the starting point
    if 'X' in hz.columns:
        hz['well_X'] = hz['X'].iloc[0]
        hz['well_Y'] = hz['Y'].iloc[0] if 'Y' in hz.columns else 0.0
    else:
        hz['well_X'] = 0.0
        hz['well_Y'] = 0.0

    # ── Metadata ──────────────────────────────────────────────────────────
    hz['well_id'] = well_id
    hz['ps_idx']  = ps
    #just identifers
    return hz, ps


