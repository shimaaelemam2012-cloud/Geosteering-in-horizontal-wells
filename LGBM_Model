results_df.to_csv(OUTPUT_DIR / 'lgbm_predictions.csv', index=False)
print(f'Predictions saved: {len(results_df):,} rows')
print(f'OOF RMSE: {oof_rmse:.4f} ft')

print('DWT feature function ready.')
