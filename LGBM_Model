# DWT feature extraction function
#function takes one well GR signal and returns 4 DWT features
# For GR signal:
# Approximation = slow geological trend (low frequency)
# Detail level 1 = medium scale variations (bed boundaries)
# Detail level 2 = fine scale variations
# Detail level 3 = very fine details
def extract_dwt_features(signal, wavelet='db4', level=3):
    n = len(signal)
    coeffs = pywt.wavedec(signal, wavelet, level=level)    # Decompose signal into wavelet coefficients
    features = {}
    # separates the smooth trend (approximation) and the fine variaions (details)
    #interpolating alot but still standard practice so fine and improved error abit when checke in light GBM
    approx = coeffs[0]
    features['DWT_approx'] = np.interp(
        np.linspace(0, 1, n), np.linspace(0, 1, len(approx)), approx
    )
    # DWT coefficients are shorter than the Original GR signal as each layer halves the length so we apply interpolation fro the remaining data
    for i, detail in enumerate(coeffs[1:], 1):
        features[f'DWT_detail_{i}'] = np.interp(
            np.linspace(0, 1, n), np.linspace(0, 1, len(detail)), detail
        )
    return features
