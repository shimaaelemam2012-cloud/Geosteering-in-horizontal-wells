# Histogram matching function (for DTW_pred)
#
# Maps horizontal GR distribution onto typewell GR distribution.
# Horizontal GR (e.g. 31-217) and typewell GR (e.g. 28-158) come from
# different logging tools with different calibration ranges.
# Histogram matching remaps percentile-to-percentile so both signals
# are comparable for DTW.

def histogram_match(source, reference):
    percentiles = np.linspace(0, 100, 1000)
    source_pcts    = np.percentile(source,    percentiles)
    reference_pcts = np.percentile(reference, percentiles)
    mapping = interp1d(
        source_pcts, reference_pcts, kind='linear',
        bounds_error=False,
        fill_value=(reference_pcts[0], reference_pcts[-1])
    )
    return mapping(source)

print('Histogram matching function ready.')
def dtw_predict_tvt(hz_gr_matched, tw, bandwidth_pct=0.15):
    """
    takes all the below values to return the desired DTW TVT prediction
    hz_gr_matched : horizontal GR after histogram matching to typewell scale
    tw            : typewell dataframe, sorted by TVT, with GR and TVT columns
    bandwidth_pct : Sakoe-Chiba band as fraction of typewell length (fixed,
                    no DE — literature fallback "manually test 5/10/15/20%")
    """
    #need values as numpy
    tw_gr  = tw['GR'].values.astype(np.double)
    tw_tvt = tw['TVT'].values
    hz_gr  = hz_gr_matched.astype(np.double)

    window = max(1, int(bandwidth_pct * len(tw_gr)))
    path = dtw_lib.warping_path(hz_gr, tw_gr, window=window)#there is a specific python library for this imported in the import cell and used here

    # path = list of (hz_idx, tw_idx) pairs, possibly many-to-one in
    # either direction. Build sparse (hz_idx -> tvt) pairs, dedupe by
    # averaging tw_tvt for repeated hz_idx, then interpolate over all
    # hz rows so every row gets a value (no zeros).
    pair_dict = {}
    for hz_idx, tw_idx in path:
        pair_dict.setdefault(hz_idx, []).append(tw_tvt[tw_idx])

    hz_idxs = np.array(sorted(pair_dict.keys()))
    hz_vals = np.array([np.mean(pair_dict[i]) for i in hz_idxs])

    all_idx = np.arange(len(hz_gr))
    tvt_pred = np.interp(all_idx, hz_idxs, hz_vals)
    return tvt_pred

